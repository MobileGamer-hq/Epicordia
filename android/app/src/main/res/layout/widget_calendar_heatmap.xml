<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_heatmap_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_card_bg">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="82% Focus Rate"
        android:textColor="#2563EB"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Visual Workflow • August 2026"
        android:textColor="#6B7280"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical">

        <!-- Row 0 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:orientation="horizontal">
            <ImageView android:id="@+id/day_0" android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/widget_day_square_0" />
            <ImageView android:id="@+id/day_1" android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/widget_day_square_0" />
            <ImageView android:id="@+id/day_2" android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/widget_day_square_0" />
            <ImageView android:id="@+id/day_3" android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/widget_day_square_0" />
            <ImageView android:id="@+id/day_4" android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/widget_day_square_0" />
            <ImageView android:id="@+id/day_5" android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/widget_day_square_0" />
            <ImageView android:id="@+id/day_6" android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:background="@drawable/widget_day_square_0" />
        </LinearLayout>

        <!-- Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:orientation="horizontal">
            <ImageView android:id="@+id/day_7" android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/widget_day_square_0" />
            <ImageView android:id="@+id/day_8" android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/widget_day_square_0" />
            <ImageView android:id="@+id/day_9" android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/widget_day_square_0" />
            <ImageView android:id="@+id/day_10" android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/widget_day_square_0" />
            <ImageView android:id="@+id/day_11" android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/widget_day_square_0" />
            <ImageView android:id="@+id/day_12" android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/widget_day_square_0" />
            <ImageView android:id="@+id/day_13" android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:background="@drawable/widget_day_square_0" />
        </LinearLayout>

        <!-- Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:orientation="horizontal">
            <ImageView android:id="@+id/day_14" android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/widget_day_square_0" />
            <ImageView android:id="@+id/day_15" android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/widget_day_square_0" />
            <ImageView android:id="@+id/day_16" android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/widget_day_square_0" />
            <ImageView android:id="@+id/day_17" android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/widget_day_square_0" />
            <ImageView android:id="@+id/day_18" android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/widget_day_square_0" />
            <ImageView android:id="@+id/day_19" android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/widget_day_square_0" />
            <ImageView android:id="@+id/day_20" android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:background="@drawable/widget_day_square_0" />
        </LinearLayout>

        <!-- Row 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <ImageView android:id="@+id/day_21" android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/widget_day_square_0" />
            <ImageView android:id="@+id/day_22" android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/widget_day_square_0" />
            <ImageView android:id="@+id/day_23" android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/widget_day_square_0" />
            <ImageView android:id="@+id/day_24" android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/widget_day_square_0" />
            <ImageView android:id="@+id/day_25" android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/widget_day_square_0" />
            <ImageView android:id="@+id/day_26" android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/widget_day_square_0" />
            <ImageView android:id="@+id/day_27" android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:background="@drawable/widget_day_square_0" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
