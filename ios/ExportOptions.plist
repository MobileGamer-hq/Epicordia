<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Distribution method: app-store for App Store submission -->
    <key>method</key>
    <string>app-store</string>

    <!-- Your Apple Developer Team ID — find it at https://developer.apple.com/account -->
    <!-- Log in, go to Membership Details, copy your Team ID (10-char alphanumeric) -->
    <key>teamID</key>
    <string>YOUR_TEAM_ID_HERE</string>

    <!-- Automatically manage signing (recommended for most apps) -->
    <key>signingStyle</key>
    <string>automatic</string>

    <!-- Upload to App Store Connect after export (set to false if you want to upload manually) -->
    <key>uploadBitcode</key>
    <false/>

    <!-- Generate dSYM for crash symbolication -->
    <key>uploadSymbols</key>
    <true/>

    <!-- Strip Swift symbols to reduce binary size -->
    <key>stripSwiftSymbols</key>
    <true/>

    <!-- Thinning: none sends universal binary (recommended for App Store) -->
    <key>thinning</key>
    <string>&lt;none&gt;</string>
</dict>
</plist>
